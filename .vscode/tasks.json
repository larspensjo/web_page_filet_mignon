{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build workspace",
      "type": "shell",
      "command": "cargo build --workspace",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Run app",
      "type": "shell",
      "command": "cargo run --package harvester_app",
      "group": "none",
      "problemMatcher": [
        "$rustc"
      ],
      "dependsOn": "Build workspace"
    },
    {
      "label": "Test workspace",
      "type": "shell",
      "command": "cargo nextest run",
      "group": "test",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Clippy",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Format",
      "type": "shell",
      "command": "cargo fmt --all",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Clean workspace",
      "type": "shell",
      "command": "cargo clean",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Lint scripts (PSScriptAnalyzer)",
      "type": "shell",
      "command": "Invoke-ScriptAnalyzer -Path ${workspaceFolder}\\scripts -Recurse -Settings ${workspaceFolder}\\scripts\\PSScriptAnalyzerSettings.psd1",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
