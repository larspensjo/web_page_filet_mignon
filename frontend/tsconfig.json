{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		"lib": ["ES2022", "DOM"],
		"allowJs": false,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"paths": { "@fixtures/*": ["../crates/harvester_ui_bridge/fixtures/*"] }
	},
	"include": ["src"]
}
